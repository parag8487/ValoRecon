# ValoRecon server configuration (copy to .env — .env is gitignored)

# The server binds to 127.0.0.1 by default (loopback only, never exposed on LAN).
HOST=127.0.0.1
PORT=8799

# Optional: Gemini API key. You can also set it in the app (Settings -> AI Engine),
# which takes precedence over this env var. Leave empty to use Settings only.
GEMINI_API_KEY=

# Optional: override the default model (defaults to gemini-3.5-flash).
GEMINI_MODEL=
